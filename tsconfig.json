{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "react-transfer-list": ["./src/index.ts"]
    },
    "target": "ES2018",
    "lib": ["ES2018", "DOM"],
    "module": "ESNext",
    "jsx": "react",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true
  },
  "include": ["src"]
}
