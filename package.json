{
  "name": "@veeyem/react-transfer-list",
  "version": "1.0.0",
  "description": "A configurable dual-list transfer component with search, filters, and copy/paste support",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src demo vite.demo.config.ts rollup.config.js eslint.config.js vitest.config.ts vitest.setup.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"demo/**/*.{ts,tsx}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"demo/**/*.{ts,tsx}\" \"*.{js,ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "start": "vite --config vite.demo.config.ts",
    "demo": "vite --config vite.demo.config.ts"
  },
  "keywords": [
    "react",
    "transfer-list",
    "dual-list",
    "picker"
  ],
  "author": "Shamil Vm",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shamilvm/react.transfer.list"
  },
  "license": "MIT",
  "sideEffects": [
    "**/styles/injectStyles.ts",
    "**/styles/componentStyles.ts"
  ],
  "type": "module",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^4.58.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
